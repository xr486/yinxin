echo '<option   value="已拒签">已拒签</option>';
echo '</select></div>';
if (!isset($_POST['FromDate'])) {
    $_POST['FromDate'] = date("Y-m-d", mktime(0, 0, 0, date("m"), date("d") - 30, date("Y")));
}
if (!isset($_POST['ToDate'])) {
    $_POST['ToDate'] = Date('Y-m-d');
}
echo '<div class="text-nav-1 "><div>' . '需求日' . _('起') . ':</div>
		<input type="text" onfocus="WdatePicker()" alt="' . $_SESSION['DefaultDateFormat'] . '" name="FromDate" maxlength="10" size="11" value="" /></div>
		<div class="text-nav-1 "><div>' . _('需求日止') . ':</div>
		<input type="text" onfocus="WdatePicker()" alt="' . $_SESSION['DefaultDateFormat'] . '" name="ToDate" maxlength="10" size="11" value="" /></div>
	</div>';

echo '</table><div class="centre"><input type="submit" name="Search" value="查找"> </div>'
    . '</br>';

if (isset($result) or (isset($_POST['Search']) or  isset($_POST['Go']) or isset($_POST['Next']) or isset($_POST['Previous']))) {
    $ListCount = DB_num_rows($result);
    $ListPageMax = ceil($ListCount / $_SESSION['DisplayRecordsMax']);

    if (isset($_POST['Next'])) {
        if ($_POST['PageOffset'] < $ListPageMax) {
            $_POST['PageOffset'] = $_POST['PageOffset'] + 1;
        }
    }
    if (isset($_POST['Previous'])) {
        if ($_POST['PageOffset'] > 1) {
            $_POST['PageOffset'] = $_POST['PageOffset'] - 1;
        }
    }
    echo '<input type="hidden" name="PageOffset" value="' . $_POST['PageOffset'] . '" />';
    if ($ListPageMax > 1) {
        echo '<br /><div class="centre">&nbsp;&nbsp;' . _('第') . '' . $_POST['PageOffset'] . ' ' . _('页，共') . ' ' . $ListPageMax . ' ' . _('页') . '. ' . _('转到页') . ': ';
        echo '<select name="PageOffset1">';
        $ListPage = 1;
        while ($ListPage <= $ListPageMax) {
            if ($ListPage == $_POST['PageOffset']) {
                echo '<option value="' . $ListPage . '" selected="selected">' . $ListPage . '</option>';
            } else {
                echo '<option value="' . $ListPage . '">' . $ListPage . '</option>';
            }
            $ListPage++;
        }
        echo '</select>
        <input type="submit" name="Go1" value="' . _('转到') . '" />
        <input type="submit" name="Previous" value="' . _('上一页') . '" />
        <input type="submit" name="Next" value="' . _('下一页') . '" />';
        echo '</div>';
    }
    echo '			  <div class="text-nav-table">
                    <table cellpadding="2" class="selection" >';

    echo '<tr>
                    <th class="ascending"  >' . _('订单号') . '</th>
                    <th class="ascending"width = 90>' . _('状态') . '</th>
                    <th class="ascending" >' . _('客户简称') . '</th>
					<th class="ascending" >' . _('客户订单号') . '</th>';

    echo '<th  width = 90>' . _('含税金额') . '</th>    
					<th  width = 90>' . _('未税金额') . '</th>   
					<th  width = 90>' . _('税金') . '</th>   
					<th  width = 90>' . _('已出货金额') . '</th>     ';

    echo ' <th class="ascending"width = 90>' . _('税别') . '</th>                         
                  
                    <th class="ascending"width = 120>' . _('备注') . '</th> 
                    <th class="ascending"width = 100>' . _('需求日期') . '</th> 
                    <th style="display:none;" class="ascending"width = 100>' . _('核准日期') . '</th>
                    <th class="ascending"width = 180>' . _('下单日期') . '</th>
					<th   >' . _('打印') . '</th>
            </tr>';
    $k = 0; //row counter to determine background colour
    $RowIndex = 0;

    $all_order_all_amount = 0;
    $all_all_line_amount = 0;
    $all_tax_amount = 0;
    $all_ship_amount = 0;
    $all_line = 0;
    if (DB_num_rows($result) <> 0) {
        DB_data_seek($result, ($_POST['PageOffset'] - 1) * $_SESSION['DisplayRecordsMax']);
        $i = 0; //counter for input controls
        while (($myrow = DB_fetch_array($result)) and ($RowIndex <> $_SESSION['DisplayRecordsMax'])) {
            if ($k == 1) {
                echo '<tr class="EvenTableRows">';
                $k = 0;
            } else {
                echo '<tr class="OddTableRows">';
                $k = 1;
            }
            $approve_date = '';
            if ($myrow['approve_date'] > 1) {
                $approve_date = date('Y-m-d', $myrow['approve_date']);
            }
            $all_line = $all_line + 1;
            $all_order_all_amount = $all_order_all_amount + $myrow['order_all_amount'];
            $all_all_line_amount = $all_all_line_amount + $myrow['all_line_amount'];
            $all_tax_amount = $all_tax_amount + $myrow['tax_amount'];
            $all_ship_amount = $all_ship_amount + $myrow['ship_amount'];
            //	<td><a href="' . $RootPath . '/PrintSo.php?OrderNum=' .$myrow['order_number'] . '">' . '打印' .'<img src="%s/css/' . $Theme . '/images/pdf.png" title="' . _('Click for PDF') . '" alt="" /></a></td> 
            echo '  <td><a href="' . $RootPath . '/SearchSO2.php?Updateorder_number=' . $myrow['order_number'] . '"target="_blank">' . $myrow['order_number'] . '</td>			
				<td>' . $myrow['status'] . '</td>
                                <td>' . $myrow['customer_code'] . '</td>
                                <td>' . $myrow['customer_order_number'] . '</td> ';

            echo '    <td style="text-align:center;">' . sprintf("%.2f",$myrow['order_all_amount']) . '</td> 
                                <td style="text-align:center;">' . sprintf("%.2f",$myrow['all_line_amount']) . '</td>     
                                <td style="text-align:center;">' . sprintf("%.2f",$myrow['tax_amount']) . '</td>
                                <td style="text-align:center;">' . sprintf("%.2f",$myrow['ship_amount']) . '</td>  ';

            echo '  <td>' . $myrow['tax_name'] . '</td>  
                                <td>' . $myrow['remark'] . '</td>
                                <td>' . date('Y-m-d', $myrow['need_date']) . '</td>
								
                                <td style="display:none;">' . $approve_date . '</td>
				<td>' . date('Y-m-d H:i:s', $myrow['creation_date']) . '</td>
				 <td><a href="' . $RootPath . '/PrintQuote.php?Updatedelivery_num=' . $myrow['order_number'] . '"target="_blank">打印 </td>
                                 ';


            echo '
			</tr>';
            $i++;
            $RowIndex++;
            //end of page full new headings if
        } //end loop through vendors

        echo '<td>合计</td>  <td> 行数</td>
	      <td>' . $all_line  . '</td>   <td>' . sprintf("%.2f",$all_order_all_amount)  . '</td>  	<td>' . sprintf("%.2f",$all_all_line_amount)  . '</td>   
			<td>' . sprintf("%.2f",$all_tax_amount)  . '</td>  	<td>' . sprintf("%.2f",$all_ship_amount)  . '</td>  
            ';

        echo '</table>
        </div>';
        echo '<input type="hidden" name="JustSelectedAvendor" value="Yes" />';          
        echo '<div>
        <a href="' . $RootPath . '/SearchSOExcel.php?order_number=' . $_POST['order_number'] .
            '&customer_name=' . $_POST['customer_name'] . '&customer_code=' . $_POST['customer_code'] . '&employee_name=' . $_POST['employee_name'] . '&employee_num=' . $_POST['employee_num'] . '&dengji=' . $_POST['dengji'] . '&checkresult=' . $_POST['checkresult'] . '&item_name=' . $_POST['item_name'] .  '&FromDate=' . $_POST['FromDate'] . '&ToDate=' . $_POST['ToDate'] . ' ">' . '资料导出Excel表' . '</a>
    </div>';
    }    

    if (isset($ListPageMax) and $ListPageMax > 1) {
        echo '<br /><div class="centre">&nbsp;&nbsp;' . _('第') . '' . $_POST['PageOffset'] . ' ' . _('页，共') . ' ' . $ListPageMax . ' ' . _('页') . '. ' . _('转到页') . ': ';
        echo '<select name="PageOffset2">';
        $ListPage = 1;
        while ($ListPage <= $ListPageMax) {
            if ($ListPage == $_POST['PageOffset']) {
                echo '<option value="' . $ListPage . '" selected="selected">' . $ListPage . '</option>';
            } else {
                echo '<option value="' . $ListPage . '">' . $ListPage . '</option>';
            }
            $ListPage++;
        }
        echo '</select>
        <input type="submit" name="Go2" value="' . _('转到') . '" />
        <input type="submit" name="Previous" value="' . _('上一页') . '" />
        <input type="submit" name="Next" value="' . _('下一页') . '" />';
        echo '</div>';
    }
}
