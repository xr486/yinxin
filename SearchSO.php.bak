<a class="btn btn-info btn-xs" id="btn_slect_customer_code" hfre="###" title="选择客户">选</a></div>';
echo '<div class="text-nav-2 "><div>' . _('客户名称') . ':</div>';
echo '<input type="text" name="customer_name" id="text_slect_name" value="' . $_POST['customer_name'] . '" size="20" maxlength="25" />
<a class="btn btn-info btn-xs" id="btn_slect_customer_name" hfre="###" title="选择客户">选</a></div>';

echo '<div class="text-nav-1 "><div>' . _('订单状态') . ':</div><select name="checkresult">';

echo '<option  selected="selected" value="' . $_POST['checkresult'] . '">' . $_POST['checkresult'] . '</option>';
