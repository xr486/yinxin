if (isset($_POST['Go1']) or isset($_POST['Go2'])) {
    $_POST['PageOffset'] = (isset($_POST['Go1']) ? $_POST['PageOffset1'] : $_POST['PageOffset2']);
    $_POST['Go'] = '';
}
if (!isset($_POST['PageOffset'])) {
    $_POST['PageOffset'] = 1;
} else {
    if ($_POST['PageOffset'] == 0) {
        $_POST['PageOffset'] = 1;
    }
}

if (isset($_POST['Search']) or isset($_POST['Go']) or isset($_POST['Next']) or isset($_POST['Previous'])) {

    $sql = "SELECT
    a.order_number,
    a.status,
    b.customer_code,a.customer_order_number,
    a.all_line_amount,a.tax_amount,
    a.header_remark,
    a.need_date,
    a.creation_date,approve_date,a.coycode,a.tax_name,a.order_all_amount,(select sum(d.quantity_shiped * d.price) from so_lines_all d where d.order_number=a.order_number) ship_amount 
FROM so_headers_all a, customers b,hr_employees e
WHERE  a.customer_code = b.customer_code and e.employee_num=a.yewu
";
/*
     if ($_SESSION['SaleFlag'] == 'Y') {
        $sql = $sql . " and  b.employee_num='" . $_SESSION['SalesMan'] . "' ";
    }  */

    if (isset($_POST['order_number']) and $_POST['order_number'] != '') {
        $sql = $sql . " and a.order_number " . LIKE . " '%" . $_POST['order_number'] . "%' ";
    }

    if (isset($_POST['customer_name']) and $_POST['customer_name'] != '') {
        $sql = $sql . " and b.customer_name " . LIKE . " '%" . $_POST['customer_name'] . "%' ";
    }
    if (isset($_POST['customer_code']) and $_POST['customer_code'] != '') {
        $sql = $sql . " and b.customer_code " . LIKE . " '%" . $_POST['customer_code'] . "%' ";
    }

    if (isset($_POST['employee_name']) and $_POST['employee_name'] != '') {
        $sql = $sql . " and e.employee_name " . LIKE . " '%" . $_POST['employee_name'] . "%' ";
    }
    if (isset($_POST['employee_num']) and $_POST['employee_num'] != '') {
        $sql = $sql . " and e.employee_num " . LIKE . " '%" . $_POST['employee_num'] . "%' ";
    }
    if (isset($_POST['customer_order_number']) and $_POST['customer_order_number'] != '') {
        $sql = $sql . " and a.customer_order_number " . LIKE . " '%" . $_POST['customer_order_number'] . "%' ";
    }
    if (isset($_POST['checkresult']) and $_POST['checkresult'] != '') {
        $sql = $sql . " and a.status " . LIKE . " '%" . $_POST['checkresult'] . "%' ";
    }


    if (empty($_POST['FromDate']) == 0) {
        $SQL_FromDate = strtotime($_POST['FromDate']);
        $sql .= " and a.need_date >= '" . $SQL_FromDate . "' ";
    }
    if (empty($_POST['ToDate']) == 0) {
        $SQL_ToDate = strtotime($_POST['ToDate']) + 86400;
        //echo $SQL_ToDate;
        $sql .= " and a.need_date <='" . $SQL_ToDate . "' ";
    }

    $sql .= " order by a.creation_date DESC";
	//echo $sql;
    $result = DB_query($sql, $db);
    if (DB_num_rows($result) == 0) {
        //unset($result);
        prnMsg(_('找不到该订单，请重新输入条件查询！'), 'error');
    }
}


echo '<form action="' . htmlspecialchars($_SERVER['PHP_SELF'], ENT_QUOTES, 'UTF-8') . '" method="post">';
echo '<div>';
