						 $insertDel="insert into inv_onhand_quantity_all(stockid,cost_price,quantity,subinventory_code,creation_date,created_by,last_update_date,last_updated_by) values('" . $stockid . "','" . $price . "','" . $del_qty . "','".$subcode."','".$del_date."','".$_SESSION['UserID'] ."','".$del_date."','".$_SESSION['UserID'] ."')";
