    $sql = "select 
a.request_name,a.need_quantity 	, 
a.item_no,
c.item_desc,
	c.item_name, 
c.units  
FROM  wip_material_request_lines a,
                        sf_item_no c 
WHERE  a.item_no=c.item_no 
and ifnull(a.issue_quantity,0)=0
      ";
 
