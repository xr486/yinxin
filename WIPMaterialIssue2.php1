                        $sqltrancsation.="values( '" . $rec_num . "','" . $receipt_line . "','" . $po_num . "','" . $line . "','" . $stockid . "','POIN','" . $del_date . "','" . $del_qty . "','" . $del_date . "','" . $_SESSION['UserID'] . "','" . $del_date . "','" . $_SESSION['UserID'] . "')";
 
