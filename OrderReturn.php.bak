				'100' + (
					max(substr(delivery_num ,- 1)) + 1
				),
				2
			)
		ELSE
			substr(max(delivery_num),-2,2) + 1
		END
        ) order_number from so_delivery_headers_all where substr(delivery_num,-10,8) = '" . $date . "'";
        $result_num = DB_query($sql_num, $db); 
