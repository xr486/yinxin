						'".$_POST['quantity'.$i]."','".$_POST['quantity'.$i]."','".$_POST['stockid'.$i]."','".$_POST['remark'.$i]."','".$lineamount[$i]."','".$_POST['customercode']."','".$_POST['subinventory_code']."',
