include('includes/header.inc');
include('includes/SQL_CommonFunctions.inc');
unset($result);
$transaction_date=time();
if(isset($_POST['save'])){
    $wip_entity_name=$_POST['wip_entity_namen'];
        //插入表wip_resoure_transactions
        for($i=0;$i<count($_POST['wip_entity_namen']);$i++){
            //工单号码
            $wip_entity_name=$_POST['wip_entity_namen'][$i];
            //料号
            $primary_item=$_POST['primary_itemn'][$i];
            //料号名称
            $item_name=$_POST['item_namen'][$i];
            //规格型号
            $item_desc=$_POST['item_descn'][$i];
            //开工日期
            $plan_start_date=$_POST['plan_start_daten'][$i];
            //工序
            $op_code=$_POST['op_code'][$i];
            //线别
            $line_code=$_POST['line_code'][$i];
            //时长
            $transaction_quantity=$_POST['transaction_quantity'][$i];
            //单位
            $transaction_uom=$_POST['transaction_uom'][$i];
            //产量
            $chanliang=$_POST['chanliang'][$i];
            //异常代码
            $yichang_code=$_POST['yichang_code'][$i];
            //责任人员
            $zeren_person=$_POST['zeren_person'][$i];
            //生产日期
            $transaction_date=strtotime($_POST['transaction_date']);
            //时间日期
            $last_update_date=time();
            $last_updated_by=$_SESSION['UserID'];
            $creation_date=time();
            $created_by=$_SESSION['UserID'];

            //判断时长和产量是否有一个为空
            if($transaction_quantity==""&& $chanliang==""){
                continue;
            }elseif($transaction_quantity!=""&& $chanliang==""){
                prnMsg(_($wip_entity_name.'产量不能为空') ,'error');die;
            }elseif($transaction_quantity==""&& $chanliang!=""){
                prnMsg(_($wip_entity_name.'工时不能为空') ,'error');die;
            }
                $sql="insert into wip_resoure_transactions
                    (wip_entity_name,transaction_date,op_code,line_code,transaction_quantity,
                     transaction_uom,chanliang,yichang_code,zeren_person,last_update_date,
                     last_updated_by,creation_date,created_by)
                    value('".$wip_entity_name."','".$transaction_date."','".$op_code."',
                        '".$line_code."','".$transaction_quantity."','".$transaction_uom."',
                        '".$chanliang."','".$yichang_code."','".$zeren_person."',
                        '".$last_update_date."','".$last_updated_by."','".$creation_date."',
                        '".$created_by."')";
                $result = DB_query($sql,$db);
                prnMsg(_($wip_entity_name.'工单工时录入成功') ,'success');

        }
        if($result){
             prnMsg(_('工单工时录入成功') ,'success');
         }else{
             prnMsg(_('工单工时录入失败') ,'error');
         }


}
