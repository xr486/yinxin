//开工日期起
$plan_start_date=strtotime($_POST['plan_start_date']);
//开工日期止
$plan_end_date=strtotime($_POST['plan_end_date']);

$sql='select a.*,c.item_name,c.item_desc from wip_jobs_all a,sf_item_no c
        where (a.STATUS_TYPE not in ("关闭"))
        and a.primary_item=c.item_no';
if(!empty($wip_entity_name)){
    $sql=$sql." and a.wip_entity_name like '%".$wip_entity_name."%'";
}
if(!empty($stockid)){
    $sql=$sql." and a.primary_item like '%".$stockid."%'";
}
if(!empty($item_name)){
    $sql=$sql."and c.item_name like '%".$item_name."%'";
}
if(!empty($plan_start_date)){
    $sql=$sql." and a.plan_start_date >='".$plan_start_date."'";
}
if(!empty($plan_end_date)){
     $sql=$sql." and a.plan_end_date <='".$plan_end_date."'";
}
$result = DB_query($sql, $db);
if (DB_num_rows($result) == 0) {
    unset($result);
    prnMsg(_('找不到该工单，请重新输入条件查询！'), 'error');die;
}
