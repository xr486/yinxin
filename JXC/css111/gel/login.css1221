*{margin: 0px;padding: 0px;outline: none;}
body{
Line-height:24px;
color:#e1e1e1;


	}
#container {
background: url(images/erp.png) no-repeat #016aa9;
background-size:contain;
margin-left:auto;
margin-right:auto;
margin-top:50px;
width:1200px;
height:533.12px;
text-align: left;
font-size:17px ;
   }
#login_logo {
background:url("../logo.png") no-repeat scroll center center ;
border:none;
margin-left:310px;
height:64px;
padding:0;
width:70px;
 }

#login_box{
margin-left:530px;
margin-top:210px;
width:180px;
	}
select {
margin-top:13px;
color:#e1e1e1;
width:120px;
height:25px;
border-radius:8px 8px 8px 8px;
background-color:transparent;
border:1px solid ;
border-color:#1a4e6f #1a4c6d #356795 #1b5c6e ;
box-shadow: 10px 10px 13px #000028 inset; /* ��Ӱ */
Text-indent:0.2em;
    }
input {
color:#e1e1e1;
width:150px;
height:20px;
border:1px solid ;
border-color:#1a4e6f #1a4c6d #244766 #1b5c6e ;
background-color:transparent;
border-radius:14px;
box-shadow: 10px 10px 13px #000028 inset; /* ��Ӱ */
Text-indent:1em;
}



input[type="submit"]{
margin-top:5px;
margin-left:0px;
width:100px;
height:30px;
font-size:20px ;
border-radius:3px;
color:#f03a0d;
box-shadow: -2px 0px 13px #094a73 inset  ;  /* ��Ӱ */
border:0;
Text-indent:0;
}
