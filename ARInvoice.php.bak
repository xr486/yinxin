<script type="text/javascript">

function checktotal(){       
								   var  all_invoice_amount=0; 
								   var  all_dis_amount=0;                
                                for(var i=1 ; i < 50; i++){   
									if (document.getElementById("this_invoice_amount" + i)==null)  {
									p=0;
										}
									else {							
								   var  invoice_amount=0;
								   var  dis_amount=0;
                                   var invoice_amount=document.getElementById("this_invoice_amount"+i).value;   
                                   var dis_amount=document.getElementById("this_invoice_dis_amount"+i).value;                               								     
								   if( invoice_amount>0 )
								   {  
								   all_invoice_amount=Number(all_invoice_amount) + Number(invoice_amount);                                 
                                   }
								   if( dis_amount>0 )
								   {  
								   all_dis_amount=Number(all_dis_amount) + Number(dis_amount);                                 
                                   }

								    }}
									
                     var tax_rate=document.getElementById("text_slect_tax_rate").value;  

		            document.getElementById("invoice_amount_all").value=all_invoice_amount;
		            document.getElementById("invoice_dis_amount").value=all_dis_amount; 
		            document.getElementById("tax_amount").value=Math.round(Number(all_invoice_amount*tax_rate)*100)/100;
								}
   
function checkall(thisform){for(var i=0;i<thisform.elements.length;i++){if(thisform.elements[i].type=="checkbox"&&thisform.elements[i].checked==false&&thisform.elements[i].name!="selectall"){thisform.elements[i].checked=true;}else if(thisform.elements[i].type=="checkbox"&&thisform.elements[i].checked==true&&thisform.elements[i].name!="selectall"){thisform.elements[i].checked=false;}} }
    
function  check(s1){
	    var a=document.getElementById("this_invoice_amount"+s1).value;
        var b=document.getElementById("this_invoice_dis_amount"+s1).value;
        var c=document.getElementById("text_wait_amount"+s1).value;
        var invoice_amount=document.getElementById("invoice_amount"+s1).value;
        var dis_invoice_amount=document.getElementById("dis_invoice_amount"+s1).value;
        var order_all_amount=document.getElementById("order_all_amount"+s1).value;
        var d=parseFloat(a) + parseFloat(b);
		var already_amount=parseFloat(invoice_amount) + parseFloat(dis_invoice_amount);
        var total_amount=parseFloat(already_amount) + parseFloat(d);
      if(parseFloat(total_amount)>parseFloat(order_all_amount)){
            document.getElementById("Prompt").innerHTML="本次开票金额不可以大于未开票金额！！！！";
            document.getElementById("this_invoice_amount"+s1).value="";
            document.getElementById("this_invoice_amount"+s1).focus();
        } else if(parseFloat(a)>parseFloat(c)){
            document.getElementById("Prompt").innerHTML="本次开票金额不可以大于待开票金额！！！！";
            document.getElementById("this_invoice_dis_amount"+s1).value="";
            document.getElementById("text_this_invoice_dis_amount"+s1).focus();
        }else if(parseFloat(a)<0){
            document.getElementById("Prompt").innerHTML="开票金额不可以小于0！！！！";
            document.getElementById("this_invoice_amount"+s1).value="";
            document.getElementById("this_invoice_amount"+s1).focus();
        } else if(parseFloat(b)<0){
            document.getElementById("Prompt").innerHTML="免开票金额不可以小于0！！！！";
            document.getElementById("this_invoice_dis_amount"+s1).value="";
            document.getElementById("this_invoice_dis_amount"+s1).focus();
        } else {
            document.getElementById("Prompt").innerHTML="";
        }
     }

